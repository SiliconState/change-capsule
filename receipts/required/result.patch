-    fn recover_checkpointing(&self, capsule: &mut Capsule) -> Result<Option<String>> {
-        Ok(self
-            .finish_checkpoint(capsule)?
-            .map(|checkpoint| format!("completed interrupted checkpoint {}", checkpoint.commit)))
