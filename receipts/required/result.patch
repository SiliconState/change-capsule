-            CapsuleState::Active => self.recover_active(&mut capsule)?,
-            CapsuleState::Integrating => self.recover_integrating(&mut capsule)?,
-            CapsuleState::Dropping => Some(self.finish_cleanup(&mut capsule)?),
-            CapsuleState::Closed
