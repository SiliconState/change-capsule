+fn checkpoint_ref(capsule: &Capsule) -> String {
+    format!("refs/change-capsule/{}/checkpoint", capsule.id)
+}
+
+fn integration_ref(capsule: &Capsule) -> String {
+    format!("refs/change-capsule/{}/integration", capsule.id)
+}
