+        .write(true)
+        .create_new(true)
+        .open(path)
+        .map_err(|source| change_capsule::Error::Io {
+            path: path.to_path_buf(),
+            source,
+        })?;
+    file.write_all(bytes)
+        .and_then(|()| file.sync_all())
+        .map_err(|source| change_capsule::Error::Io {
+            path: path.to_path_buf(),
+            source,
+        })?;
+    sync_parent_directory(parent_directory(path))
