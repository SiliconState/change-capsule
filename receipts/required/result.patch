+        }
+        assert!(matches!(
+            require_stable_close_snapshot(&original, "head", true, &original, "other", true),
+            Err(Error::UnsafeState(_))
+        ));
+        assert!(matches!(
+            require_stable_close_snapshot(&original, "head", true, &original, "head", false),
+            Err(Error::UnsafeState(_))
+        ));
+    }
+}
