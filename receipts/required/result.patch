+fn result_sha256(result: &CapsuleResult) -> Result<String> {
+    let bytes = serde_json::to_vec(result).map_err(|source| Error::Json {
+        path: PathBuf::from("result digest"),
+        source,
+    })?;
+    Ok(sha256_hex(&bytes))
